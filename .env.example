APP_NAME="Call Joe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
APP_PORT=8090
VITE_PORT=5180
FORWARD_DB_PORT=5433
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=call_joe_web
DB_USERNAME=sail
DB_PASSWORD=password
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=http://localhost:9000/local
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
FORWARD_REVERB_PORT=8091
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8091
VITE_REVERB_SCHEME=http
REVERB_APP_ID=call-joe-local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret

# AI brains: a key for each provider you use (which model does which job is set in /admin/models, and each contact's
# own brain in /admin/contacts). Grok writes texts and makes pictures, Claude does memory, safety checks and picture
# scenes, Gemini runs calls and the cheap brains for lower-tier contacts. Groq and Giphy are optional.
# Claude: https://console.anthropic.com/settings/keys   Gemini: https://aistudio.google.com/apikey
# Grok: https://console.x.ai   Groq (optional): https://console.groq.com/keys   Giphy (GIFs, later): https://developers.giphy.com
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
GIPHY_API_KEY=

# Voice calls (voice/): our own Pipecat service speaking with Gemini Live (the GEMINI_API_KEY above). It runs on the host,
# not in Docker: Laravel reaches it at VOICE_URL, browsers at VOICE_PUBLIC_URL. VOICE_SECRET is any long random string
# (also in voice/ through this file). See voice/README.md.
VOICE_URL=http://host.docker.internal:8787
VOICE_PUBLIC_URL=http://localhost:8787
VOICE_SECRET=

# The owner admin account (php artisan db:seed --class=OwnerSeeder). Never commit the password.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_BIRTH_DATE=
OWNER_TIMEZONE=America/Chicago

# Pictures contacts send come from Grok Imagine (XAI_API_KEY above). IMAGES_DISK is where they're stored (local, or s3 in production).
XAI_IMAGE_MODEL=grok-imagine-image
IMAGES_DISK=local

# Paid plans (Braintree): https://sandbox.braintreegateway.com while developing (Settings > API). Create a monthly plan
# in Billing > Plans and put its id in BRAINTREE_PLAN_PAID. Point the webhook (Settings > Webhooks) at
# APP_URL/webhooks/braintree for the subscription events.
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_PLAN_PAID=

# Behind a load balancer (production): "*" or a comma-separated list of proxy addresses. Empty trusts none.
TRUSTED_PROXIES=
