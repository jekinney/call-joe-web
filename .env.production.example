# Production settings for the server (see docs/deploying.md). Copy to `.env` ON THE SERVER, fill in, and never commit it.
# Anything marked CHANGE must be set before the first start.

APP_NAME="Call Joe"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # CHANGE: php artisan key:generate --show (the deploy script makes one if empty)
# The address people use. With a domain: https://your-domain. Before that: http://<droplet ip>.
APP_URL=http://CHANGE
# Caddy's address: your domain (it gets HTTPS by itself), or :80 for plain HTTP on the IP.
SITE_ADDRESS=:80
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=call_joe_web
DB_USERNAME=calljoe
DB_PASSWORD=CHANGE

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false    # true once APP_URL is https
CACHE_STORE=database
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real-time. The browser connects to the same address as the site (Caddy sends WebSockets to Reverb).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=call-joe
REVERB_APP_KEY=CHANGE
REVERB_APP_SECRET=CHANGE
VITE_REVERB_HOST=CHANGE        # the domain, or the droplet IP
VITE_REVERB_PORT=80            # 443 once on https
VITE_REVERB_SCHEME=http        # https once on a domain

# Pictures: DigitalOcean Spaces (S3-compatible). Create a Space and a key in the DigitalOcean control panel.
FILESYSTEM_DISK=local
IMAGES_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Email (needed for verification and password resets). Any SMTP service works.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@CHANGE"
MAIL_FROM_NAME="${APP_NAME}"

# The AIs.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
GIPHY_API_KEY=

# Calls: the voice service runs on the same server. Browsers reach it through the site at /voice.
VOICE_URL=http://host.docker.internal:8787
VOICE_PUBLIC_URL=http://CHANGE/voice
VOICE_SECRET=CHANGE            # any long random string

# The first owner account (created by `php artisan db:seed --class=OwnerSeeder`).
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_BIRTH_DATE=
OWNER_TIMEZONE=America/Chicago

# Payments: stay on sandbox until the real account is approved.
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_PLAN_PAID=

XAI_IMAGE_MODEL=grok-imagine-image
